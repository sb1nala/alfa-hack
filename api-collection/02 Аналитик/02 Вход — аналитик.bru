meta {
  name: Вход — аналитик
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  X-CSRF-Token: {{csrf}}
}

body:json {
  {
    "login": "{{analystLogin}}",
    "password": "{{analystPassword}}"
  }
}

tests {
  test("HTTP 200", function () {
    expect([200]).to.include(res.status);
  });
}

docs {
  JWT приходит в HttpOnly cookie `access_token`; Bruno хранит cookie сам.
}
