meta {
  name: Очередь ручной проверки
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/underwriter/applications?status=MANUAL_REVIEW
  body: none
  auth: none
}

script:post-response {
  if (res.body.items.length) bru.setVar("uwApplicationId", res.body.items[0].id);
}

tests {
  test("HTTP 200", function () {
    expect([200]).to.include(res.status);
  });
}

docs {
  Сначала проведите клиента demo-manual до MANUAL_REVIEW.
}
