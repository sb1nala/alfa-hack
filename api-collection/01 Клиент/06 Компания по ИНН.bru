meta {
  name: Компания по ИНН
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/companies/lookup?inn={{inn}}
  body: none
  auth: none
}

script:post-response {
  if (res.body && res.body.company) bru.setVar("companyJson", JSON.stringify(res.body.company));
}

tests {
  test("HTTP 200", function () {
    expect([200]).to.include(res.status);
  });
}

docs {
  Автозаполнение анкеты по ЕГРЮЛ/ЕГРИП.
}
