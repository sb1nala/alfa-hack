{
  "name": "alfa-hack-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm api:check && pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:generate": "openapi-typescript ../docs/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../docs/openapi.yaml -o src/api/schema.d.ts --check",
    "mock:api": "prism mock ../docs/openapi.yaml --host 127.0.0.1 --port 4010",
    "test": "node --test src/api/*.test.ts src/lib/*.test.ts",
    "test:prism": "node scripts/check-prism.ts",
    "test:recovery": "node scripts/check-recovery.cjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.104.5",
    "openapi-fetch": "0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
