# Одна переменная переключает dev-прокси между настоящим API и Prism.
# Настоящий backend (по умолчанию):
API_PROXY_TARGET=http://127.0.0.1:8000
# Prism: API_PROXY_TARGET=http://127.0.0.1:4010
# После изменения frontend/.env перезапустите pnpm dev.
# Браузер всегда использует /api на origin фронтенда, прямой CORS не нужен.
