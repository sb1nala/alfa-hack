# Local development only. Set your own password before using shared environments.
POSTGRES_DB=alfa_hack
POSTGRES_USER=alfa_hack
POSTGRES_PASSWORD=local-dev-change-me
# Host/port for running the backend outside Docker; Compose uses db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_READINESS_TIMEOUT=2
BACKEND_PORT=8000
