# Local development only. Set your own password before using shared environments.
POSTGRES_DB=alfa_hack
POSTGRES_USER=alfa_hack
POSTGRES_PASSWORD=local-dev-change-me
# Host/port for running the backend outside Docker; Compose uses db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_READINESS_TIMEOUT=2
BACKEND_PORT=8000
# Mocks of credit bureau, company registry and tax service (http://localhost:8001/docs)
MOCKS_PORT=8001
# Artificial latency of every mock response, ms — makes the CHECKING step visible in the demo
MOCKS_LATENCY_MS=300

# Required runtime secret, no shared default. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=alfa-hack
AUTH_JWT_AUDIENCE=alfa-hack-web
AUTH_SESSION_HOURS=8
# Exact frontend/API origin, including port; no trailing slash. Origin is required for mutations.
AUTH_ALLOWED_ORIGIN=http://localhost:8000
# Explicit local HTTP opt-in. Use true with an HTTPS origin on a shared deployment.
AUTH_COOKIE_SECURE=false
